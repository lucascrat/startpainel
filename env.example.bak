# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Efibank Configuration
EFIBANK_CLIENT_ID=
EFIBANK_CLIENT_SECRET=
EFIBANK_PIX_KEY=
EFIBANK_CERT_PATH=./homologacao-906554-shopcrat.p12
EFIBANK_SANDBOX=true

# StartPainel Admin Credentials
STARTPAINEL_ADMIN_USER=
STARTPAINEL_ADMIN_PASS=
STARTPAINEL_URL=https://cms.startpainel.cc
