@echo off
set CHROME_PATH=

if exist "C:\Program Files\Google\Chrome\Application\chrome.exe" (
    set "CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe"
) else if exist "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe" (
    set "CHROME_PATH=C:\Program Files (x86)\Google\Chrome\Application\chrome.exe"
) else if exist "%USERPROFILE%\AppData\Local\Google\Chrome\Application\chrome.exe" (
    set "CHROME_PATH=%USERPROFILE%\AppData\Local\Google\Chrome\Application\chrome.exe"
)

if "%CHROME_PATH%" == "" (
    echo [ERRO] Nao foi possivel encontrar o Google Chrome automaticamente.
    echo Por favor, instale o Google Chrome ou inicie-o manualmente com o parametro: --remote-debugging-port=9222
    pause
    exit /b
)

echo [OK] Google Chrome encontrado em: "%CHROME_PATH%"
echo.
echo =====================================================================
echo [ATENCAO] FECHE TODAS AS JANELAS DO CHROME ANTES DE CONTINUAR!
echo =====================================================================
echo O Chrome precisa estar TOTALMENTE FECHADO antes de rodar este script.
echo Vamos forcar o fechamento de qualquer Chrome escondido agora...
taskkill /F /IM chrome.exe /T >nul 2>&1
taskkill /F /IM chrome-native-host.exe /T >nul 2>&1
echo.
pause

echo [INFO] Iniciando Google Chrome em modo de Depuracao Remota (porta 9222)...
echo [INFO] Usando seu PERFIL NORMAL DO CHROME para passar direto no Captcha!
echo [INFO] IMPORTANTE: Deixe esta janela preta aberta, e deixe o Chrome rodando livremente.
echo.

start "" "%CHROME_PATH%" --remote-debugging-port=9222 --user-data-dir="%LOCALAPPDATA%\Google\Chrome\User Data"

echo Chrome iniciado com sucesso!
pause
