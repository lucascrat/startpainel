{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "A client managed in the StartPainel system",
      "type": "object",
      "properties": {
        "username": { "type": "string", "description": "StartPainel username" },
        "whatsapp": { "type": "string", "description": "WhatsApp number" },
        "status": { "type": "string", "enum": ["active", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A support chat session",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId"]
    },
    "Message": {
      "title": "Message",
      "description": "A message in a chat",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "ai", "admin"] },
        "type": { "type": "string", "enum": ["text", "pix_qr", "pix_copy_paste"] },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "sender", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "A Pix payment transaction",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "expired"] },
        "txid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "amount", "status", "createdAt"]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Collection of clients to be renewed"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Support chat sessions"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a chat"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Pix payment tracking"
    },
    "/settings/global": {
      "schema": {
        "title": "GlobalSettings",
        "type": "object",
        "properties": {
          "geminiApiKey": { "type": "string" },
          "efibankPixKey": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Global settings for Efibank and StartPainel"
    }
  }
}
